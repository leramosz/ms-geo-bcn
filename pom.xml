<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.4</version>
		<relativePath/>
	</parent>

	<groupId>com.geobcn</groupId>
	<artifactId>geo-bcn-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>geo-bcn-service</name>
	<description>Geo BCN API</description>

	<properties>
		<java.version>17</java.version>
		<openapi.generator.version>7.6.0</openapi.generator.version>
		<springdoc.version>2.8.6</springdoc.version>
		<lombok.version>1.18.32</lombok.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>

	<dependencies>
		<!-- Web + Validación -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Swagger UI + anotaciones io.swagger.v3 -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!-- JsonNullable (por si el generador lo usa) -->
		<dependency>
			<groupId>org.openapitools</groupId>
			<artifactId>jackson-databind-nullable</artifactId>
			<version>0.2.6</version>
		</dependency>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
			<scope>provided</scope>
			<optional>true</optional>
		</dependency>

		<!-- Test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Surefire (JUnit en Java 17) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration><useModulePath>false</useModulePath></configuration>
			</plugin>

			<!-- Spring Boot -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<version>${project.parent.version}</version>
			</plugin>

			<!-- Compiler + annotation processing (Lombok) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<release>${java.version}</release>
					<excludes>
						<exclude>org/openapitools/OpenApiGeneratorApplication.java</exclude>
					</excludes>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<!-- OpenAPI Generator (delegatePattern + Lombok) -->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>${openapi.generator.version}</version>
				<executions>
					<execution>
						<id>generate-openapi</id>
						<phase>generate-sources</phase>
						<goals><goal>generate</goal></goals>
						<configuration>
							<!-- coloca aquí tu contrato -->
							<inputSpec>${project.basedir}/src/main/resources/api/openapi.yaml</inputSpec>

							<generatorName>spring</generatorName>
							<output>${project.build.directory}/generated-sources/openapi</output>

							<!-- paquetes generados bajo tu raíz -->
							<apiPackage>com.geobcn.service.infrastructure.generated.openapi.api</apiPackage>
							<modelPackage>com.geobcn.service.infrastructure.generated.openapi.model</modelPackage>

							<!-- añade las fuentes generadas a la compilación -->
							<addCompileSourceRoot>true</addCompileSourceRoot>

							<configOptions>
								<!-- Controller + Delegate -->
								<delegatePattern>true</delegatePattern>
								<interfaceOnly>false</interfaceOnly>

								<!-- Spring Boot 3 / Jakarta -->
								<useSpringBoot3>true</useSpringBoot3>
								<useJakartaEe>true</useJakartaEe>

								<!-- Lombok en modelos (sin builders para evitar constructores raros) -->
								<useLombok>true</useLombok>
								<additionalModelTypeAnnotations>
									@lombok.Builder
								</additionalModelTypeAnnotations>

								<!-- Varias útiles -->
								<useBeanValidation>true</useBeanValidation>
								<library>spring-boot</library>
								<hideGenerationTimestamp>true</hideGenerationTimestamp>

								<!-- sin archivos extra de soporte -->
								<generateApiTests>false</generateApiTests>
								<generateModelTests>false</generateModelTests>
								<generateSpringApplication>false</generateSpringApplication>
								<generateSupportingFiles>false</generateSupportingFiles>
							</configOptions>

							<skipValidateSpec>false</skipValidateSpec>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- asegura que el código generado está en el classpath de compile -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>add-source</id>
						<phase>generate-sources</phase>
						<goals><goal>add-source</goal></goals>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-sources/openapi/src/main/java</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>